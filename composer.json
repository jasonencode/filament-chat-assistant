{
    "name": "jason/filament-chat-assistant",
    "description": "AI chat assistant dialog plugin for Filament panels",
    "keywords": [
        "jason",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-chat-assistant"
    ],
    "homepage": "https://github.com/jason/filament-chat-assistant",
    "support": {
        "issues": "https://github.com/jason/filament-chat-assistant/issues",
        "source": "https://github.com/jason/filament-chat-assistant"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Jason.Chen",
            "email": "20511924@qq.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "laravel/ai": "^1.3",
        "livewire/livewire": "^4.4",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Jason\\FilamentChatAssistant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jason\\FilamentChatAssistant\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "test": "@php vendor/phpunit/phpunit/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jason\\FilamentChatAssistant\\FilamentChatAssistantServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
